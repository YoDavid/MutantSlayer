      value: 
      objectReference: {fileID: 1523366424}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: CoverPanelFadeDelay
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: CoverPanelForImages
      value: 
      objectReference: {fileID: 1935769409}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: overrideAllSlideDurations
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[0].name
      value: "Slide 1 \u2013 \"Saturn\u2019s End\" "
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[0].text
      value: "It began with Saturn\u2019s demise. \nThe planet cracked, its remains
        hurled across the stars, as if the heavens themselves rejected what it had
        become."
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[1].name
      value: "Slide 2 \u2013 \"Impact\" "
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[1].text
      value: "When the fragments struck Earth they didn\u2019t just destroy\u2014they
        corrupted. The impact warped the land\n and the fragments twisted life into
        something new and grotesque."
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[2].name
      value: "Slide 3 \u2013 \"Aftermath\""
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[2].text
      value: "Five years passed. \nThe world was fractured\u2014its people even more
        so.\nTwo factions emerged: the Dominion, seeking order through technology
        and the Vagabonds thriving in chaos and mutation."
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[3].name
      value: "Slide 4 \u2013 \"Deployment\" "
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[3].text
      value: "To eliminate the growing threat, Dominion forces were deployed into
        the Vagabond-controlled wild zones. \nThey underestimated what awaited them."
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[4].name
      value: "Slide 5 \u2013 \"Captured\" "
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[4].text
      value: "But the wastelands were not empty. \nThe Vagabonds had grown stronger\u2014armed
        with salvaged tech, mutant beasts, and doctrine. \nThe Dominion squad was
        outnumbered, overwhelmed... and taken. Dragged beneath the surface into labs
        fueled by madness."
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[5].name
      value: "Slide 6 \u2013 \"Broken Chain\" Part 0"
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[5].text
      value: 'One of the marines endured. Subjected to unspeakable experiments, his
        mind drowned in chemicals meant to make him a puppet. '
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[6].name
      value: "Slide 6 \u2013 \"Broken Chain\" Part 1"
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[6].text
      value: "But something within broke through. Rage, instinct, memory\u2014they
        tore apart the drugs meant to chain him. "
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[7].name
      value: "Slide 6 \u2013 \"Broken Chain\" Part 2"
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[7].text
      value: "He awoke in fury, tearing free of his chains and ripping through the
        Vagabond scientists with brutal force\u2014turning the lab into a slaughterhouse
        of blood and fire."
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[8].name
      value: Slide 6 - "Broken Chain" Part 3
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[8].text
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[9].name
      value: Slashes
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[9].text
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: CoverPanelForImagesFadeDuration
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: CoverPanelForImagesFadeDurtaion
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[10].name
      value: "Slide 7 \u2013 \"The Awakening\" "
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[10].text
      value: "His name is forgotten. His past\u2014erased. But his purpose burned
        bright: to cleanse the world of beasts and those who made him one."
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[11].name
      value: "Slide 8 \u2013 \"The Hunt Begins\" "
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[11].text
      value: "Now he hunts. Mutated creatures, twisted warlords, corrupted factions\u2026
        all fall beneath his blade. He is no longer a soldier\u2014he is the reckoning."
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[12].name
      value: "Slide 9 \u2013 \"Begin.\" "
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[12].text
      value: "No allies. No name. Only a path carved in blood. This is his world
        now. This... is the age of the\_Mutant\_Slayer."
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[0].fontSize
      value: 45
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
      propertyPath: slideGroups.Array.data[1].fontSize
      value: 45
      objectReference: {fileID: 0}
    - target: {fileID: 6862411451082095404, guid: 046ecfac34c64344a9c69f1753c94380, type: 3}
